# Application Environment
NODE_ENV=development
PORT=3000

# Database Configuration
DB_NAME=wom_booking
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Session Configuration
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-session-secret-32-chars-minimum-here

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# Mock Data Configuration
# Mode: minimal | standard | full
MOCK_DATA_MODE=standard
MOCK_DATA_SEED=12345
MOCK_BOOKINGS_COUNT=50
MOCK_BOOKING_OCCUPANCY=0.3
MOCK_SOLD_OUT_PROBABILITY=0.1
MOCK_PRE_ORDER_PROBABILITY=0.15
MOCK_GROUP_BOOKING_PROBABILITY=0.3
MOCK_BROKEN_SEAT_PROBABILITY=0.05
MOCK_MAX_BROKEN_SEATS=10

# Frontend Configuration
VITE_API_URL=http://localhost:3000/api
VITE_BACKEND_URL=http://localhost:3000

# Docker Configuration
POSTGRES_DB=wom_booking
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres

# pgAdmin Configuration
PGADMIN_DEFAULT_EMAIL=admin@wom.hk
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050

# Database Auto-Setup
DB_SYNC_FORCE=false
DB_AUTOSETUP=true
