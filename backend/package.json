{
  "name": "western-orchestral-backend",
  "version": "1.0.0",
  "description": "Backend API with ORM and Express",
  "main": "src/server.js",
  "type": "module",
  "imports": {
    "#models/*": "./src/models/*",
    "#config/*": "./src/config/*",
    "#controllers/*": "./src/controllers/*",
    "#services/*": "./src/services/*",
    "#middleware/*": "./src/middleware/*",
    "#utils/*": "./src/utils/*",
    "#db/*": "./src/db/*",
    "#routes/*": "./src/routes/*"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "format": "prettier --write \"src/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\"",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "db:seed": "node src/db/seed.js",
    "db:seed:all": "sequelize-cli db:seed:all",
    "db:seed:undo:all": "sequelize-cli db:seed:undo:all",
    "db:setup": "npm run db:migrate && npm run db:seed:all",
    "db:reset": "npm run db:migrate:undo:all && npm run db:migrate && npm run db:seed:all",
    "db:fresh": "node src/db/seed.js",
    "db:cli": "node src/db/cli.js",
    "db:clean": "node src/db/cli.js clean",
    "db:init": "node src/db/cli.js init",
    "db:seed-only": "node src/db/cli.js seed",
    "db:setup-full": "node src/db/cli.js setup",
    "db:reset-full": "node src/db/cli.js reset",
    "db:fix-venue-sequence": "node src/db/fix-venue-sequence.js",
    "download:mock-images": "node src/db/data/downloadMockImages.js"
  },
  "keywords": [
    "orchestral",
    "booking",
    "express",
    "postgresql"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@faker-js/faker": "^9.9.0",
    "@scalar/express-api-reference": "^0.8.24",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dayjs": "^1.11.10",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.17.3",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "memorystore": "^1.6.7",
    "module-alias": "^2.2.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^7.0.11",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "sanitize-html": "^2.11.0",
    "sequelize": "^6.35.2",
    "sharp": "^0.33.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.1",
    "validator": "^13.11.0",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@jest/globals": "^29.7.0",
    "ajv": "^8.17.1",
    "commander": "^14.0.2",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.1.0",
    "fast-check": "^4.3.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "sequelize-cli": "^6.6.3"
  }
}
