{
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "#models/*": [
                "src/models/*"
            ],
            "#config/*": [
                "src/config/*"
            ],
            "#controllers/*": [
                "src/controllers/*"
            ],
            "#services/*": [
                "src/services/*"
            ],
            "#middleware/*": [
                "src/middleware/*"
            ],
            "#utils/*": [
                "src/utils/*"
            ],
            "#db/*": [
                "src/db/*"
            ],
            "#routes/*": [
                "src/routes/*"
            ]
        },
        "module": "ESNext",
        "target": "ES2020"
    },
    "exclude": [
        "node_modules",
        "dist",
        "logs"
    ]
}