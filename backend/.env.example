# Application Environment
NODE_ENV=development
PORT=3000

# Database Configuration
# PostgreSQL connection details
DB_NAME=wom_booking
DB_USER=postgres
DB_PASSWORD=your-secure-password-here
DB_HOST=localhost
DB_PORT=5432

# Session Configuration
# REQUIRED: Must be at least 32 characters for security
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-session-secret-32-chars-minimum-here

# CORS Configuration
# Frontend URL for cross-origin requests
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
# Window in minutes and max requests per window
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# Mock Data Configuration
# Mode: minimal | standard | full
MOCK_DATA_MODE=standard
MOCK_DATA_SEED=12345
MOCK_BOOKINGS_COUNT=50
MOCK_BOOKING_OCCUPANCY=0.3
MOCK_SOLD_OUT_PROBABILITY=0.1
MOCK_PRE_ORDER_PROBABILITY=0.15
MOCK_GROUP_BOOKING_PROBABILITY=0.3
MOCK_BROKEN_SEAT_PROBABILITY=0.05
MOCK_MAX_BROKEN_SEATS=10

# Frontend Configuration (for reference)
VITE_API_URL=http://localhost:3000/api
VITE_BACKEND_URL=http://localhost:3000

# Docker Configuration (if using Docker Compose)
POSTGRES_DB=wom_booking
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgreshost

# pgAdmin Configuration (if using Docker Compose)
PGADMIN_DEFAULT_EMAIL=admin@wom.hk
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050

# Database Auto-Setup Controls
# Set to false to preserve data between restarts
DB_SYNC_FORCE=false
# Set to true to seed database if empty
DB_AUTOSETUP=true
