NODE_ENV=development
PORT=3000

POSTGRES_DB=wom_booking
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-password-here
POSTGRES_HOST=postgres

DB_NAME=wom_booking
DB_USER=postgres
DB_PASSWORD=your-secure-password-here
DB_HOST=localhost
DB_PORT=5432

SESSION_SECRET=your-session-secret-32-chars-minimum-here

CORS_ORIGIN=http://localhost:5173

RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-smtp-or-app-password-here
SMTP_FROM="WOM Booking <noreply@wom.hk>"

FRONTEND_URL=http://localhost:5173
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:3000/api

LOG_LEVEL=info

PHPPGADMIN_PORT=5050
PGADMIN_EMAIL=admin@wom.hk
PGADMIN_PASSWORD=your-pgadmin-password-here

DB_SYNC_FORCE=false
DB_AUTOSETUP=false
AUTO_SETUP=false
RESET_DB=false
SEED_DATA_AMOUNT=full
DB_POOL_MAX=5
DB_POOL_MIN=0
DB_LOGGING=true
QUERY_LOGGING=verbose
SLOW_QUERY_THRESHOLD=100
