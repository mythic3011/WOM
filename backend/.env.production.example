NODE_ENV=production
PORT=3000

DB_NAME=wom_booking_prod
DB_USER=wom_app_user
DB_PASSWORD=your-strong-production-password-here
DB_HOST=your-production-db-host.com
DB_PORT=5432

SESSION_SECRET=your-production-session-secret-64-chars-minimum-use-openssl-rand-hex-32

CORS_ORIGIN=https://your-production-domain.com

RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=your-production-email@example.com
SMTP_PASS=your-production-smtp-password-here
SMTP_FROM="WOM Booking <noreply@wom.hk>"

FRONTEND_URL=https://your-production-domain.com
VITE_API_URL=https://api.your-production-domain.com/api

LOG_LEVEL=warn

DB_SYNC_FORCE=false
DB_AUTOSETUP=false
AUTO_SETUP=false
RESET_DB=false
SEED_DATA_AMOUNT=minimal
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_LOGGING=false
QUERY_LOGGING=error
SLOW_QUERY_THRESHOLD=500
