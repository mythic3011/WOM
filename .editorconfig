root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
max_line_length = off

[*.{js,jsx,ts,tsx,vue}]
indent_size = 2
quote_type = double

[*.{json,yml,yaml}]
indent_size = 2

[*.html]
indent_size = 2

[*.css]
indent_size = 2

[Makefile]
indent_style = tab

[*.{sh,bash}]
indent_size = 2

[package.json]
indent_size = 2

